  <ItemGroup>
    <!-- Compilation des shaders ImGui via fxc.exe (compilateur HLSL du XDK
         Xbox 360, confirme le 2026-08-01 : "Microsoft (R) D3DX9 Shader
         Compiler 2.0.21256.0 Xbox 360", chemin confirme par l'utilisateur -
         voir PROJECT_NOTES.md, "Sixieme build reel"). Pas d'element de
         compilation HLSL natif dans cette installation de Visual Studio
         (liste des types d'element verifiee cote utilisateur : pas
         d'"Xbox 360 HLSL Compiler"/"Effect Compiler Tool" - seulement les
         types generiques + "Custom Build Tool", utilise ici). S'execute
         automatiquement a chaque build (MSBuild compare la date du .hlsl a
         celle du .h de sortie) - remplace le placeholder #error par le
         vrai microcode compile, aucune etape manuelle requise une fois ce
         wiring en place. -->
    <CustomBuild Include="third_party\imgui\shaders\imgui_vs.hlsl">
      <!-- /Zpr (empaquetage des matrices en LIGNES) ajoute le 2026-08-01 :
           sans cette option, fxc empaquette ProjectionMatrix en COLONNES
           dans c0-c3 (confirme dans le commentaire genere par fxc lui-meme,
           "defconst ProjectionMatrix, float, matrix_columns, [4, 4], c0-3")
           - alors que ImGui_ImplDX9_SetupRenderState (imgui_impl_dx9_xenon.cpp)
           remplit mat_projection[16] et appelle SetVertexShaderConstantF en
           supposant un empaquetage par LIGNES. Ce decalage corrompait le
           calcul de position de chaque sommet - cause reelle confirmee du
           rendu "ecran quasi noir, fine ligne bleue" observe au premier
           lancement (voir PROJECT_NOTES.md, "Jalon 3"). -->
      <Command Condition="'$(Configuration)|$(Platform)'=='Release Retail|Xbox 360'">"C:\Program Files (x86)\Microsoft Xbox 360 SDK\bin\win32\fxc.exe" /nologo /Zpr /Tvs_2_0 /Emain /Fh"third_party\imgui\shaders\imgui_vs.h" /Vng_ImGuiVertexShader "third_party\imgui\shaders\imgui_vs.hlsl"</Command>
      <Outputs Condition="'$(Configuration)|$(Platform)'=='Release Retail|Xbox 360'">third_party\imgui\shaders\imgui_vs.h</Outputs>
      <Message Condition="'$(Configuration)|$(Platform)'=='Release Retail|Xbox 360'">Compilation du vertex shader ImGui (fxc.exe, cible vs_2_0)</Message>
    </CustomBuild>
    <CustomBuild Include="third_party\imgui\shaders\imgui_ps.hlsl">
      <Command Condition="'$(Configuration)|$(Platform)'=='Release Retail|Xbox 360'">"C:\Program Files (x86)\Microsoft Xbox 360 SDK\bin\win32\fxc.exe" /nologo /Tps_2_0 /Emain /Fh"third_party\imgui\shaders\imgui_ps.h" /Vng_ImGuiPixelShader "third_party\imgui\shaders\imgui_ps.hlsl"</Command>
      <Outputs Condition="'$(Configuration)|$(Platform)'=='Release Retail|Xbox 360'">third_party\imgui\shaders\imgui_ps.h</Outputs>
      <Message Condition="'$(Configuration)|$(Platform)'=='Release Retail|Xbox 360'">Compilation du pixel shader ImGui (fxc.exe, cible ps_2_0)</Message>
    </CustomBuild>
  </ItemGroup>
