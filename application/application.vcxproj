  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release Retail|Xbox 360'">
    <!-- XexUtils/src et XexUtils/include ne sont PAS ajoutes ici, contrairement
         a un premier essai (voir PROJECT_NOTES.md, 2026-08-01, "vraie cause
         de la cascade d'erreurs cmath") : XexUtils/src/Math.h porte le meme
         nom que le math.h standard, et le systeme de fichiers Windows etant
         insensible a la casse, l'ajouter ici faisait resoudre TOUS les
         #include <math.h>/<cmath> du projet (rapidjson, ImGui, la libc du
         XDK...) vers ce fichier au lieu du vrai math.h du SDK - d'ou la
         cascade d'erreurs "acosf n'est pas membre de global namespace" dans
         des fichiers qui n'ont rien a voir avec XexUtils. main.cpp inclut
         desormais Input.h/Xam.h par chemin relatif explicite
         (..\XexUtils\src\Input.h), qui n'a pas ce probleme (voir main.cpp). -->
    <IncludePath>..\X360Remap\xkelib;..\X360Remap;.\;$(IncludePath)</IncludePath>
    <LinkIncremental>false</LinkIncremental>
    <PostBuildEventUseInBuild>false</PostBuildEventUseInBuild>
    <RemoteRoot>HDD:\X360RemapStudio\</RemoteRoot>
    <ImageXexOutput>$(OutDir)X360RemapStudio.xex</ImageXexOutput>
    <OutputFile>$(OutDir)X360RemapStudio$(TargetExt)</OutputFile>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release Retail|Xbox 360'">
    <ClCompile>
      <AdditionalIncludeDirectories>..\X360Remap\xkelib;..\X360Remap;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <Optimization>Full</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <PreprocessorDefinitions>NDEBUG;_XBOX;LTCG</PreprocessorDefinitions>
      <StringPooling>true</StringPooling>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <PrecompiledHeaderOutputFile>$(OutDir)$(ProjectName).pch</PrecompiledHeaderOutputFile>
      <WholeProgramOptimization>true</WholeProgramOptimization>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>..\X360Remap\xkelib</AdditionalLibraryDirectories>
      <!-- xkelib.lib retire d'ici le 2026-08-01 (etait copie du pattern
           X360Remap.vcxproj, qui EN A besoin car X360Remap.xex est un plugin
           DashLaunch qui hooke le D3D9 du xam.xex DEJA EN COURS D'EXECUTION -
           application.xex n'est pas dans ce cas, c'est un .xex autonome qui
           cree son propre device D3D9 independant). Cause reelle d'une
           erreur de link (LNK2005, "already defined") : xkelib.lib fournit
           SA PROPRE copie de D3DDevice_SetStreamSource/CreateVertexBuffer/
           DrawIndexedVertices/etc. (des forwarders vers le device du
           processus hote, utiles a un plugin, inutiles et en conflit ici),
           qui entrait en collision avec les vraies implementations de
           d3d9.lib. Verifie (recherche dans le vrai code source de
           ClementDreptin/XexUtils) que rien de ce que ce projet utilise
           (Input::GetInput -> XInputGetState/XInputGetKeystroke standard ;
           Xam::XNotify -> ResolveExport = GetModuleHandle+GetProcAddress a
           l'execution, aucune dependance de lien) n'a besoin de xkelib.lib -
           seul usb.h/mapping.h/main.cpp l'avaient hérité par copier-coller
           du .vcxproj du plugin, jamais reellement utilise (aucun fichier
           source de application/ ne le reference, verifie par recherche).
           d3dx9.lib retire a nouveau le 2026-08-01 : D3DXCompileShader (qui
           en avait besoin) a ete abandonne suite a un echec de link (26
           symboles internes a d3dx9.lib non resolus - voir
           third_party\imgui\shaders\README.md et PROJECT_NOTES.md) - les
           shaders ImGui sont desormais precompiles hors ligne, plus besoin
           de d3dx9.lib du tout. -->
      <AdditionalDependencies>d3d9.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <SetChecksum>true</SetChecksum>
      <ProgramDatabaseFile>$(ProjectDir)$(Configuration)application.pdb</ProgramDatabaseFile>
    </Link>
    <ImageXex>
      <ConfigurationFile>xex.xml</ConfigurationFile>
    </ImageXex>
    <Deploy>
      <DeploymentType>CopyToHardDrive</DeploymentType>
    </Deploy>
    <Deploy>
      <ExcludedFromBuild>true</ExcludedFromBuild>
      <Progress>true</Progress>
      <ForceCopy>true</ForceCopy>
    </Deploy>
  </ItemDefinitionGroup>
