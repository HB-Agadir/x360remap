    <ClInclude Include="..\XexUtils\src\Input.h" />
    <ClInclude Include="..\XexUtils\src\Xam.h" />
    <!-- Filesystem.h/.cpp ajoutes le 2026-08-01 (voir PROJECT_NOTES.md,
         "HDD: introuvable depuis application.xex") : XexUtils::Fs::MountHdd()
         est necessaire AVANT tout acces a "HDD:\..." depuis ce binaire -
         contrairement a X360Remap.xex (plugin DashLaunch, tourne DANS le
         processus xam.xex du dashboard, qui a deja "hdd:" mappe en tant que
         lien symbolique SYSTEME), application.xex est un titre lance de
         maniere independante, avec son propre namespace d'objets prive - il
         n'herite d'aucun mapping "HDD:" et doit le creer lui-meme. -->
    <ClInclude Include="..\XexUtils\src\Filesystem.h" />
    <ClInclude Include="..\XexUtils\src\Kernel.h" />
